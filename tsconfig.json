{
    "compilerOptions": {
      "allowJs": false,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "declaration": false,
      "sourceMap": false,
      "strict": false,
      "module": "ES2022",
      "moduleResolution": "bundler",
      "target": "ES2022",
      "lib": [
        "ES2022",
        "dom"
      ],
      "rootDir": "./src",
      "outDir": "./lib",
      "skipLibCheck": true
    },
    "include": [
      "src/**/*.ts"
    ]
  }